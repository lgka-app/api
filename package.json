{
  "name": "lgka-api",
  "version": "1.0.0",
  "private": true,
  "description": "LGKA+ API — Cloudflare Worker that mirrors, parses and hash-syncs the Lessing-Gymnasium Karlsruhe data for the LGKA+ apps",
  "homepage": "https://api.lgka.app",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
