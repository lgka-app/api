    "types": "wrangler types",
    "sync-goldens": "tool/sync-goldens.sh"
  },
  "dependencies": {
    "hono": "^4.13.7",
    "node-html-parser": "^9.0.4",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@types/node": "^26",
    "typescript": "^7.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.131.1"
  }
